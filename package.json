{
  "name": "aaf-evote-station",
  "productName": "AAF eVote Station",
  "version": "1.0.3",
  "description": "Offline voting station for AAF eVote school elections (Windows and Android).",
  "author": "Aye-Africa Foundation",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "cap:sync": "cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.aafevote.station",
    "productName": "AAF eVote Station",
    "copyright": "Aye-Africa Foundation",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AAF-eVote-Station-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AAF eVote Station"
    }
  }
}
